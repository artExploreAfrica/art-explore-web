generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(cuid())
  fullName              String
  email                 String        @unique
  password              String
  role                  Role          @default(ADMIN)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  auditLogs             AuditLog[]
  approvedExhibitions   Exhibition[]  @relation("ExhibitionApprover")
  submittedExhibitions  Exhibition[]  @relation("ExhibitionSubmitter")
  reviewedInstitutions  Institution[] @relation("ReviewedBy")
  submittedInstitutions Institution[] @relation("SubmittedBy")
}

model SubCategory {
  id           String          @id @default(cuid())
  name         String
  type         InstitutionType
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  institutions Institution[]

  @@unique([type, name])
  @@index([type])
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  label        String
  category     TagCategory
  institutions Institution[] @relation("InstitutionToTag")

  @@index([category])
}

model Institution {
  id             String          @id @default(cuid())
  name           String
  description    String?
  type           InstitutionType
  address        String
  area           Area
  lat            Float
  lng            Float
  images         String[]
  website        String?
  instagram      String?
  phone          String?
  email          String?
  openingHours   Json?
  isPublished    Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  subCategoryId  String?
  hasExhibition  Boolean         @default(false)
  approvalStatus ApprovalStatus  @default(APPROVED)
  submittedById  String?
  reviewedById   String?
  reviewNote     String?
  reviewedAt     DateTime?
  exhibitions    Exhibition[]
  reviewedBy     User?           @relation("ReviewedBy", fields: [reviewedById], references: [id])
  subCategory    SubCategory?    @relation(fields: [subCategoryId], references: [id])
  submittedBy    User?           @relation("SubmittedBy", fields: [submittedById], references: [id])
  tags           Tag[]           @relation("InstitutionToTag")

  @@index([area])
  @@index([type])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([subCategoryId])
  @@index([hasExhibition])
  @@index([approvalStatus])
  @@index([submittedById])
}

model Exhibition {
  id             String         @id @default(cuid())
  institutionId  String
  endDate        DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  name           String
  images         String[]
  startDate      DateTime
  startTime      String
  endTime        String
  link           String?
  description    String?
  approvalStatus ApprovalStatus @default(PENDING)
  submittedById  String?
  approvedById   String?
  approvedAt     DateTime?
  isActive       Boolean        @default(false)
  approvedBy     User?          @relation("ExhibitionApprover", fields: [approvedById], references: [id])
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  submittedBy    User?          @relation("ExhibitionSubmitter", fields: [submittedById], references: [id])

  @@index([institutionId])
  @@index([startDate])
  @@index([approvalStatus])
  @@index([submittedById])
  @@index([approvedById])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String
  action      AuditAction
  targetModel TargetModel
  targetId    String
  metadata    Json?
  timestamp   DateTime    @default(now())
  actor       User        @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetModel, targetId])
  @@index([timestamp])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum InstitutionType {
  ART_GALLERY
  STUDIO
  CULTURAL_SPACE
  MUSEUM
  INSTITUTE
  FOUNDATION
}

enum Area {
  ISLAND
  MAINLAND
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TagCategory {
  OWNERSHIP
  STYLE
  CURATION
  FORMAT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  DEACTIVATE
  IMAGE_UPLOAD
  SUBMIT
  APPROVE
  REJECT
  APPROVE_USER
  REJECT_USER
  APPROVE_INSTITUTION
  REJECT_INSTITUTION
  EXHIBITION_CREATE
  EXHIBITION_UPDATE
  EXHIBITION_DELETE
  APPROVE_EXHIBITION
  REJECT_EXHIBITION
}

enum TargetModel {
  INSTITUTION
  USER
  SUBCATEGORY
  TAG
  EXHIBITION
}
