# ----------------------------------------------------------------------------
# Art Explore Backend — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All variables are validated at startup (src/config/env.ts) via Zod —
# a missing or malformed value crashes the app with a clear message.
# ----------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Comma-separated CORS allowlist (e.g. https://app.artexplore.africa,https://admin.artexplore.africa).
# Leave empty to allow any origin (development only — set this before go-live).
ALLOWED_ORIGINS=

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/art_explore?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 (gallery images only)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="eu-west-1"
AWS_S3_BUCKET_NAME="art-explore-images"

# Upstash Redis (refresh tokens + response cache only)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Email (Resend).
# EMAIL_FROM must be a verified Resend sender/domain. FRONTEND_URL is the public web app
# base used to build password-reset links (e.g. {FRONTEND_URL}/reset-password?token=...).
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="no-reply@artexplore.africa"
FRONTEND_URL="https://app.artexplore.africa"

# Default Super Admin (used by prisma/seed.ts)
SEED_SUPER_ADMIN_NAME="Art Explore Admin"
SEED_SUPER_ADMIN_EMAIL="admin@artexplore.africa"
SEED_SUPER_ADMIN_PASSWORD="change-me-on-first-login"
