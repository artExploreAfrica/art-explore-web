# Local development settings. Copy to `.env` and run `docker compose up -d`
# (see README -> "Quick start"). `.env` is gitignored: never commit real secrets.

# The dev script frees port 4555 before starting, so keep this value.
PORT=4555
NODE_ENV=development

# Matches docker-compose.yml (Postgres on host port 5435).
DATABASE_URL=postgresql://artexplore:artexplore@localhost:5435/artexplore?schema=public

# Any random strings of 16+ characters work locally.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 is only used for admin image uploads. The app starts without a real bucket;
# uploading photos needs real credentials.
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev
AWS_REGION=eu-west-1
AWS_S3_BUCKET_NAME=art-explore-local

# Local Redis REST proxy from docker-compose.yml (token must match SRH_TOKEN there).
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

EMAIL_FROM=no-reply@artexplore.local
FRONTEND_URL=http://localhost:5173

# Account created by `npm run seed` (use it to log in at /admin).
SEED_SUPER_ADMIN_NAME="Local Admin"
SEED_SUPER_ADMIN_EMAIL=admin@artexplore.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
