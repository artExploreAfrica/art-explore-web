# Base URL of the Art Explore backend API.
# Local dev: the backend's .env sets PORT=4555 (the code default is 4000, but the
# committed .env overrides it — always match whatever PORT is in the root .env).
# Production: set this to your deployed API origin, e.g. https://api.artexplore.ng
VITE_API_URL=http://localhost:4555

# MapTiler key for the basemap tiles used by MapView.
# Client-side keys ship in the browser bundle, so restrict yours to your domains
# in the MapTiler dashboard rather than treating it as a secret.
VITE_MAPTILER_KEY=your-maptiler-key
